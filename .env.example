# Local identity. This fallback is accepted only on localhost/127.0.0.1.
LOCAL_DEV_USER_EMAIL=local@pulse-ai.test
LOCAL_DEV_USER_NAME=Local Pulse AI User

# Use a unique value with at least 24 characters. It encrypts credentials in
# the local MySQL database and must remain stable between local runs.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-local-key

# Docker uses this default automatically. Change it to use another MySQL 8+
# server, and set LOCAL_MYSQL_MANAGED=false before running npm run local.
MYSQL_URL=mysql://pulse:pulse-local-password@127.0.0.1:3307/pulse_ai
LOCAL_MYSQL_PROXY_URL=http://127.0.0.1:8789
LOCAL_MYSQL_MANAGED=true

# Optional legacy owner credentials. Prefer entering Alpaca credentials in the
# Settings screen so they stay encrypted in the local database.
OWNER_EMAIL=local@pulse-ai.test
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_AUTO_TRADE=false

# Backtesting archive: local directory (including a mounted external/network
# drive), or an HTTP(S) base URL serving v1/history/SYMBOL/1Day.json or
# static SYMBOL.1Day.json files.
BACKTESTING_DATA_SOURCE=backtesting_data
BACKTESTING_DATA_PORT=8790
# Fail daily requests when a symbol is absent from the configured archive.
BACKTESTING_DATA_STRICT_DAILY=false
# Optional bearer token for a private HTTP(S) archive endpoint.
BACKTESTING_DATA_AUTH_TOKEN=

# Natural-language rule drafting uses OpenAI Structured Outputs. Keep this
# server-side key private. Saved rule sets are disabled until enabled in the UI.
OPENAI_API_KEY=
OPENAI_RULE_MODEL=gpt-4o-mini

# Local/self-hosted launchers create an ephemeral scheduler secret automatically.
# Set a stable secret for an external scheduler calling /api/rule-sets/run-due.
RULE_SCHEDULER_SECRET=
RULE_SCHEDULER_APP_URL=http://127.0.0.1:3000
