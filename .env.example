# Local identity. This fallback is accepted only on localhost/127.0.0.1.
LOCAL_DEV_USER_EMAIL=local@pulse-ai.test
LOCAL_DEV_USER_NAME=Local Pulse AI User

# Use a unique value with at least 24 characters. It encrypts credentials in
# the local MySQL database and must remain stable between local runs.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-local-key

# Docker uses this default automatically. Change it to use another MySQL 8+
# server, and set LOCAL_MYSQL_MANAGED=false before running npm run local.
MYSQL_URL=mysql://pulse:pulse-local-password@127.0.0.1:3307/pulse_ai
LOCAL_MYSQL_PROXY_URL=http://127.0.0.1:8789
LOCAL_MYSQL_MANAGED=true

# Optional legacy owner credentials. Prefer entering Alpaca credentials in the
# Settings screen so they stay encrypted in the local database.
OWNER_EMAIL=local@pulse-ai.test
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_AUTO_TRADE=false
